[Unit]
Description=Claude Code Token Dashboard
After=network.target

[Service]
Type=simple
User=vijendra
ExecStart=/usr/bin/python3 /home/vijendra/token-dashboard/cli.py dashboard --no-open --projects-dir /home/vijendra/claude-sessions
# HOST: bind to the VPS LAN IP so the Mac browser can reach it.
# install.sh auto-detects and patches this line — replace if needed.
Environment=HOST=192.168.1.x
Environment=PORT=8080
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
