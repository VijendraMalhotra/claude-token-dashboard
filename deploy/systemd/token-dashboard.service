[Unit]
Description=Claude Code Token Dashboard
After=network.target

[Service]
Type=simple
User=USER_PLACEHOLDER
ExecStart=/usr/bin/python3 DASHBOARD_DIR_PLACEHOLDER/cli.py dashboard --no-open --projects-dir AGG_DIR_PLACEHOLDER
Environment=HOST=LAN_IP_PLACEHOLDER
Environment=PORT=8080
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
